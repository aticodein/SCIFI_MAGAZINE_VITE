{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django: Run Server",
      "type": "shell",
      "command": ".\\env\\Scripts\\Activate.ps1; python manage.py runserver",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "group": "servers"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Vite: Run Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "group": "servers"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start All Servers",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Django: Run Server",
        "Vite: Run Dev Server"
      ],
      "group": "build"
    },
    {
      "label": "Django: Migrate",
      "type": "shell",
      "command": ".\\env\\Scripts\\Activate.ps1; python manage.py migrate",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Django: Make Migrations",
      "type": "shell",
      "command": ".\\env\\Scripts\\Activate.ps1; python manage.py makemigrations",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}